# Don't bake the local virtualenv into the image — pip installs fresh
# inside the container.
venv/
.venv/

# Local-only uploads. Production stores files on the Fly Volume mounted
# at /data/uploads (set via UPLOAD_DIR env).
uploads/

# Python bytecode cache.
__pycache__/
*.pyc
*.pyo

# Local secrets — env is injected on the host, never baked into the image.
# The glob matters: `.env` alone missed `.env.bak`, which holds the Mongo
# credentials and would have been copied in by the `COPY . .` below.
.env
.env.*

# Google/Firebase service-account keys (these contain a private_key).
sa.json
*service-account*.json
*serviceaccount*.json
*-adminsdk-*.json

# Logs and editor state.
*.log
.vscode/
.idea/
.DS_Store

# Tests + helper scripts that don't need to ship to the server.
test_*.py
bootstrap_test_*.py
# Local-only seeder. It refuses to run against anything but a local mongod,
# but a data-generating script has no business inside a production image.
seed_local_test.py

# One-off migration/maintenance scripts. These are run deliberately from a
# checkout against a named database, never from inside the running container.
migrate_*.py
rollback_*.py
promote_ceo.py

# Local DB snapshots — these contain real employee records.
backups/

# Docs (keep the image lean — these stay in the repo).
*.md
